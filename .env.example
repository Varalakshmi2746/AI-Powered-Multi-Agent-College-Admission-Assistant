# =================================================================
# Root Configuration Sample for Deployment & Local Development
# =================================================================

# --- Node.js Express Backend Configuration ---
PORT=5000
NODE_ENV=production
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/college_admission_db?retryWrites=true&w=majority
# JWT Secret Key
JWT_SECRET=production_grade_jwt_secret_college_ai_2026_super_secure
# URL of the Python FastAPI Multi-Agent Service
AI_SERVICE_URL=https://ai-college-admission-agent-service.onrender.com

# --- Python FastAPI Multi-Agent Service Configuration ---
AI_PORT=8000
# Optional: Set your OpenAI API key for LLM-enhanced reasoning
# (If omitted, system automatically executes the intelligent deterministic multi-agent fallback engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- React Vite Frontend Configuration ---
# Production Backend API URL for Vercel
VITE_API_URL=https://ai-college-admission-backend.onrender.com/api
